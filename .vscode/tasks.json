{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview site",
      "type": "shell",
      "command": "python3 dev.py 8000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activatesBeforeBegin": true,
          "beginsPattern": "Previewing at",
          "endsPattern": "Previewing at"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
